# Database
MONGODB_URI=your_mongodb_uri_here

# OpenAI (for AI Search and Historian Agent)
OPENAI_API_KEY=your_openai_api_key_here
EMBEDDING_MODEL=text-embedding-3-large
VECTOR_SEARCH_INDEX_NAME=vector_index

# Analytics
NEXT_PUBLIC_MIXPANEL_TOKEN=your_mixpanel_token_here

# Local weekly SEO report (all external sources are optional)
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/search-console-service-account.json
GOOGLE_SEARCH_CONSOLE_PROPERTY=sc-domain:thevenetiaproject.com
GOOGLE_SEARCH_CONSOLE_ENABLED=false
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
MIXPANEL_SERVICE_ACCOUNT_USERNAME=
MIXPANEL_SERVICE_ACCOUNT_SECRET=
MIXPANEL_PROJECT_ID=
MIXPANEL_DATA_HOST=https://data-eu.mixpanel.com

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_CARTO_API_KEY=your_carto_basemap_api_key_here
NEXT_PUBLIC_PODCAST_URL=https://example.com/podcast
NEXT_PUBLIC_SUBSTACK_URL=https://example.substack.com
NEXT_PUBLIC_MEDIUM_URL=https://medium.com/@your-handle
NEXT_PUBLIC_AMAZON_AFFILIATE_ID=your-amazon-tag-here
